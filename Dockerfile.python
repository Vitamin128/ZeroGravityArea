# 使用轻量级 Python 镜像
FROM python:3.9-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
RUN pip install --no-cache-dir \
    pdfminer.six \
    openai \
    requests

# 拷贝源码
COPY src/pdf_parser.py .

# 暴露端口
EXPOSE 8080

# 启动服务
CMD ["python", "pdf_parser.py"]
